# 复制为 Watchman/.env 后按需修改。进程环境变量优先于本文件。

# 源码仓（也可直接改 config/repos.yaml；进程环境变量优先）
# WATCHMAN_WINDOW_MANAGER=/absolute/path/window_window_manager
# WATCHMAN_SCENE_BOARD_EXT=/absolute/path/scene_board_ext
# WATCHMAN_REPOS=/absolute/path/repos.yaml

# 分流命令写在 config/runner.yaml。默认 test，WATCHMAN_ENV=production 时用 production。
# WATCHMAN_RUN 写整条命令时优先于配置文件。提示词会接在命令最后。
# WATCHMAN_ENV=test
# WATCHMAN_RUN=cursor-agent -p --mode ask --trust --output-format text
# WATCHMAN_CURSOR=cursor-agent
# WATCHMAN_NGA=nga
# WATCHMAN_AGENT_PROMPT=/absolute/path/agent.md
# LLM_TIMEOUT_MS=120000

# 非窗口历史目录。不填则用 memory/non-window（冻结后的程序用可执行文件旁的同名目录）。
# WATCHMAN_OOS_DIR=/absolute/path/non-window
