# 复制为 Watchman/.env 后按需修改。进程环境变量优先于本文件。

# 邮件（163 SMTP；关闭时只写站内通知）
EMAIL_ENABLED=false
SMTP_HOST=smtp.163.com
SMTP_PORT=465
SMTP_USER=your_account@163.com
SMTP_PASS=your_163_auth_code
EMAIL_FROM=荣耀之窗 <your_account@163.com>

# 大模型（OpenAI 兼容 /chat/completions；火山 AI 网关等同理）
# 仅用于分流规则 4（预分流=其他 且日志白/黑名单未命中）
LLM_ENABLED=false
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=deepseek-v4-flash
# 润色专用模型（可选；不填则用 LLM_MODEL）
LLM_POLISH_MODEL=qwen3.8-flash
# id:显示名，逗号分隔；非空时请求 model 必须在列表内
LLM_MODELS=deepseek-v4-flash:DeepSeek-V4-Flash,deepseek-v4-pro:DeepSeek-V4-Pro,qwen3.7-plus:Qwen3.7-Plus,qwen3.7-max:Qwen3.7-Max,doubao-seed-2.1-pro:DouBao-Seed-2.1-Pro,MiniMax-M3:MiniMax-M3,glm-5.2:GLM-5.2,hy3:HunYuan3,glm-5.3:GLM-5.3,glm-5.3-flash:GLM-5.3-Flash,kimi-k2.7-code:Kimi-K2.7-Code,qwen3.8-flash:Qwen3.8-Flash
LLM_TIMEOUT_MS=60000
LLM_TEMPERATURE=0.7
# LLM_MAX_TOKENS=2048
